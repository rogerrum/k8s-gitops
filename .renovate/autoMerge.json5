{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto-merge trusted containers - anytime",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        "ghcr.io/tarampampam/error-pages",
        "/grafana/"
      ],
    },
    {
      description: "Auto-merge trusted containers - daily",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["after 3am and before 6am"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        "ghcr.io/coder/code-server",
        "ghcr.io/itzg/minecraft-server",
        "ghcr.io/zwave-js/zwave-js-ui",
        "itzg/mc-router",
        "nodered/node-red",
      ],
    },
    {
      description: "Auto-merge trusted containers - weekly",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 3am on Monday"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: [
        "ghcr.io/renovatebot/renovate"
      ],
    },
    {
      description: "Auto-merge leaf-app patch releases only - daily",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["after 1am and before 5am"],
      matchUpdateTypes: ["patch"],
      matchPackageNames: [
        "ghcr.io/mendhak/http-https-echo",
        "ghcr.io/k8s-at-home/unpoller",
      ],
    },
    {
      description: "Auto-merge all container digest updates",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["after 2am and before 5am"],
      matchUpdateTypes: ["digest"],
    },
    {
      description: "Auto-merge home-assistant patch releases only - daily",
      matchDatasources: ["docker"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["after 3am and before 5am"],
      matchUpdateTypes: ["patch"],
      matchPackageNames: [
        "ghcr.io/home-operations/home-assistant",
      ],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
  ],
}
